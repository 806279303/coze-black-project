# ========== 应用配置 ==========
APP_NAME=直播运营系统
DEBUG=true

# ========== 安全配置 ==========
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== 数据库配置 ==========
DATABASE_URL=sqlite:///./data.db

# ========== 文件上传配置 ==========
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800

# ========== WaveSpeedAI 去水印 API ==========
# 注册地址: https://wavespeed.ai
# 价格: 约 $0.012-0.015/次
WAVESPEED_API_KEY=your_api_key_here
WAVESPEED_ENDPOINT=https://api.wavespeed.ai/api/v3/wavespeed-ai/image-watermark-remover

# ========== 字节跳动去水印 API（备选） ==========
# BYTEDANCE_API_KEY=your_api_key_here
# BYTEDANCE_ENDPOINT=https://cv-api.bytedance.com/api/v1/watermark_removal

# ========== 巨量千川 API（投流数据） ==========
# QIANCHUAN_APP_ID=your_app_id
# QIANCHUAN_SECRET=your_secret
# QIANCHUAN_ACCESS_TOKEN=your_access_token
# QIANCHUAN_REFRESH_TOKEN=your_refresh_token
